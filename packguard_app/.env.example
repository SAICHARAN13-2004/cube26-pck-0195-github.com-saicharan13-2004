POSTGRES_DB=packguard
POSTGRES_USER=packguard_bootstrap
POSTGRES_PASSWORD=replace-with-a-unique-long-url-safe-admin-password
PACKGUARD_MIGRATOR_DB_USER=packguard_migrator
PACKGUARD_MIGRATOR_DB_PASSWORD=replace-with-a-separate-long-url-safe-migration-password
PACKGUARD_APP_DB_USER=packguard_runtime
PACKGUARD_APP_DB_PASSWORD=replace-with-a-different-long-url-safe-runtime-password
MINIO_ROOT_USER=packguard-storage
MINIO_ROOT_PASSWORD=replace-with-a-different-long-random-password
MINIO_APP_USER=packguard-app
MINIO_APP_PASSWORD=replace-with-a-third-long-random-password
PACKGUARD_SECRET_KEY=replace-with-at-least-32-random-characters
PACKGUARD_PUBLIC_URL=https://packguard.example.com
PACKGUARD_OIDC_ISSUER_URL=https://identity.example.com/tenant
PACKGUARD_OIDC_CLIENT_ID=replace-with-client-id
PACKGUARD_OIDC_CLIENT_SECRET=replace-with-client-secret
PACKGUARD_OIDC_REDIRECT_URI=https://packguard.example.com/auth/callback
PACKGUARD_PORT=8080
PACKGUARD_TRUSTED_PROXY_COUNT=1
